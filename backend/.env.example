# ── Database ─────────────────────────────────────────────
# Postgres connection string. On Railway/Render, this is provided automatically
# when you add a Postgres database to your project — copy it from there.
DATABASE_URL="postgresql://user:password@host:5432/dbname"

# Set to "true" if your host requires SSL for Postgres connections
# (Railway/Render typically do). Leave unset/false for local development.
DB_SSL=false

# ── Auth ─────────────────────────────────────────────────
# Long random string used to sign admin login tokens.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string

# ── Initial admin account ────────────────────────────────
# Used once by `npm run seed:admin` to create your admin login.
# You can change the password later by re-running that script with a new value.
SEED_ADMIN_EMAIL=you@example.com
SEED_ADMIN_PASSWORD=choose-a-strong-password

# ── Email notifications (optional) ───────────────────────
# If left unset, contact form submissions are still saved to the database,
# just without an email alert. Works with any SMTP provider:
#   - Gmail: smtp.gmail.com, port 587, use an "App Password" (not your real password)
#   - SendGrid, Mailgun, Postmark, etc. — use the SMTP credentials they provide
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=you@example.com
SMTP_PASS=your-app-password
NOTIFY_FROM=you@example.com
NOTIFY_TO=you@example.com

# ── CORS ─────────────────────────────────────────────────
# Comma-separated list of domains allowed to call this API from a browser.
# Include your GitHub Pages URL and any custom domain.
ALLOWED_ORIGINS=https://cool4y.github.io

# ── Server ───────────────────────────────────────────────
PORT=3000
